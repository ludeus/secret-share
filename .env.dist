# Secret Share - configuration
# Copier ce fichier en .env, ou mieux : lancer ./install.sh qui génère APP_SECRET.

# Clé maître (OBLIGATOIRE, 32 caractères minimum). Elle protège tous les secrets :
# la perdre ou la changer rend illisibles les secrets en cours.
# Génération : openssl rand -base64 48
APP_SECRET=

# URL publique de l'application, sans slash final (sert à construire les liens partagés)
APP_URL=http://localhost:8765

# Adresse et port d'écoute sur l'hôte. Laisser 127.0.0.1 derrière un reverse proxy,
# 0.0.0.0 pour exposer directement (HTTPS fortement recommandé dans ce cas).
APP_BIND=127.0.0.1
APP_PORT=8765

# Longueur des codes des URL courtes (8 à 64). 10 caractères ≈ 58 bits d'entropie.
SHORT_CODE_LENGTH=10

# Taille maximale d'un secret, en caractères
SECRET_MAX_LENGTH=10000

# Nombre d'essais de mot de passe avant destruction du secret
PASSWORD_MAX_ATTEMPTS=5

# Nombre maximal de secrets conservés simultanément (protège l'espace disque)
MAX_STORED_SECRETS=100000

# Nombre de calculs Argon2id simultanés (64 Mio chacun), pour borner la mémoire utilisée
ARGON2_CONCURRENCY=2

# Langue par défaut si le navigateur n'en propose aucune de disponible (fr, en)
DEFAULT_LOCALE=fr

# Lien vers le code source affiché en pied de page (obligation de la licence AGPL)
SOURCE_URL=https://github.com/ludeus/secret-share

# Image Docker utilisée par docker compose
IMAGE=ludeus/secret-share:latest
