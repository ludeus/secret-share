# Secret Share - configuration de la maintenance automatisée (maintenance/monthly.sh)
# Copier en maintenance/maintenance.env (ignoré par git) et adapter.

# Dépôt GitHub et token (fichier en droits 600) : droits Contents en écriture pour pousser
# le commit et le tag, Actions en lecture pour suivre la CI
GITHUB_REPO=ludeus/secret-share
GITHUB_TOKEN_FILE="$HOME/.config/github/claude_token"

# Image publiée par la CI sur Docker Hub
DOCKER_IMAGE=ludeus/secret-share

# Serveur à mettre à jour (laisser DEPLOY_HOST vide pour ne pas déployer) : hôte SSH
# accessible sans mot de passe, dossier contenant docker-compose.yml et .env
DEPLOY_HOST=
DEPLOY_PATH=/opt/secret-share

# URL publique sur laquelle lancer les tests fonctionnels après déploiement (vide : aucun)
PUBLIC_URL=

# Correction des vulnérabilités par Claude Code (1 : activée, 0 : désactivée)
AI_FIX=1

# Chemins supplémentaires (node, claude…) : le timer systemd démarre avec un PATH minimal
EXTRA_PATH=

# Commande de notification, qui reçoit le résumé sur son entrée standard, par exemple :
#   NOTIFY_COMMAND='notify-send "Secret Share" "$(cat)"'
#   NOTIFY_COMMAND='mail -s "Secret Share : maintenance" moi@example.org'
NOTIFY_COMMAND=

# Version de Trivy utilisée pour l'analyse
TRIVY_VERSION=0.58.1
