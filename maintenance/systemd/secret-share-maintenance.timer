# Secret Share - déclenchement mensuel de la maintenance
# Persistent : si la machine était éteinte à l'échéance, la maintenance démarre au réveil.

[Unit]
Description=Secret Share : maintenance mensuelle

[Timer]
OnCalendar=*-*-01 04:00:00
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target
